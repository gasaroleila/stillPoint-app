rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only access their own data
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Users can update their own profile, but NOT xp, growthStage, or totalActivities
      // (those are managed by Cloud Functions)
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['xp', 'growthStage', 'totalActivities']);
      // Profile creation happens during registration
      allow create: if request.auth != null && request.auth.uid == userId;

      // Subcollections under user
      match /moods/{moodId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
      }

      match /completions/{completionId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        // xpAwarded is updated by Cloud Functions only — deny client updates
        allow update: if false;
      }

      match /streak/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Streak is managed by Cloud Functions only
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /badges/{badgeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Badges are awarded by Cloud Functions only
        allow write: if false;
      }

      match /suggestions/{dateId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Users can update suggestion status (accept/skip/swap)
        allow update: if request.auth != null && request.auth.uid == userId;
        // Suggestions are generated by Cloud Functions
        allow create: if false;
      }

      match /reports/{periodId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Reports are computed by Cloud Functions only
        allow write: if false;
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
